{
  "name": "YourPeer AI Chat — Find Services",
  "short_name": "YourPeer AI Chat",
  "description": "Find shelter, food, and other services in NYC. Your conversation is private.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#FFD54F",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["lifestyle", "social", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Find shelter",
      "short_name": "Shelter",
      "description": "Search for a shelter or a place to stay",
      "url": "/chat?prefill=I+need+shelter",
      "icons": [{ "src": "/icons/shortcut-shelter-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Find food",
      "short_name": "Food",
      "description": "Search for food pantries or free meals",
      "url": "/chat?prefill=I+need+food",
      "icons": [{ "src": "/icons/shortcut-food-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Find showers",
      "short_name": "Showers",
      "description": "Search for shower facilities and personal care",
      "url": "/chat?prefill=I+need+a+shower",
      "icons": [{ "src": "/icons/shortcut-shower-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Talk to a peer navigator",
      "short_name": "Peer",
      "description": "Connect with a real person who knows the system",
      "url": "/chat?prefill=Connect+with+peer+navigator",
      "icons": [{ "src": "/icons/shortcut-peer-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
